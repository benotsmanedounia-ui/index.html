const ROOM_ORDER = ['etudes','experience','projets'];

/* progress tracking */
const roomState = {};
ROOM_ORDER.forEach(key=>{
  roomState[key] = { total: ROOMS[key].hotspots.length, done: new Set() };
});
function isRoomComplete(key){ return roomState[key].done.size >= roomState[key].total; }
function completedRoomsCount(){ return ROOM_ORDER.filter(isRoomComplete).length; }
function updateProgressBadge(){
  els.progressBadge.textContent = `${completedRoomsCount()} / ${ROOM_ORDER.length} NIVEAUX`;
}
function markHotspotDone(roomKey, hotspotId){
  const wasComplete = isRoomComplete(roomKey);
  roomState[roomKey].done.add(hotspotId);
  updateProgressBadge();
  if(!wasComplete && isRoomComplete(roomKey)){
    playBadge();
    showToast(`🏅 Salle complétée : ${ROOMS[roomKey].title}`);
    if(completedRoomsCount() >= ROOM_ORDER.length){
      setTimeout(()=> showToast('✦ Le Bureau du Président vous attend au Hall.'), 1400);
    }
  }
}

