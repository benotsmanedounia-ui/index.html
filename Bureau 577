<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>LE BUREAU 577</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
  :root{
    --bleu-nuit:#4a2140;
    --bleu-fonce:#60294f;
    --bleu-pastel:#f2b8d4;
    --bleu-pastel-clair:#fbdcec;
    --bleu-pastel-tres-clair:#fff4fa;
    --blanc:#fffaf9;
    --or:#7fae8e;
    --or-clair:#c3e4cf;
    --or-fonce:#4c7a5c;
    --encre:#34212f;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: border-box;
  }
  *{box-sizing:border-box;}
  html,body{
    height:100%;
    margin:0;
    background:
      radial-gradient(circle at 50% -10%, var(--bleu-pastel-clair) 0%, var(--bleu-pastel) 45%, var(--bleu-nuit) 100%);
    font-family:'VT323', monospace;
    color:var(--encre);
    overflow:hidden;
    -webkit-tap-highlight-color: transparent;
    user-select:none;
  }
  #stage{
    position:fixed; inset:0;
    display:flex; align-items:center; justify-content:center;
    padding: 14px;
  }
  #console-shell{
    position:relative;
    width:min(96vw, 640px);
    background: linear-gradient(160deg, var(--bleu-pastel-clair) 0%, var(--bleu-pastel) 55%, #a9678f 100%);
    border-radius: 22px;
    padding: 16px 16px 22px;
    box-shadow:
      0 2px 0 rgba(255,255,255,0.6) inset,
      0 -6px 18px rgba(20,30,60,0.25) inset,
      0 18px 40px rgba(10,15,35,0.45);
    border: 2px solid rgba(255,255,255,0.5);
  }
  #brand-row{
    display:flex; align-items:baseline; justify-content:space-between;
    padding: 2px 8px 10px;
  }
  #brand{
    font-family:'Press Start 2P', monospace;
    font-size: clamp(11px, 2.6vw, 15px);
    color: var(--bleu-nuit);
    letter-spacing: 1px;
    text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
  }
  #brand span{ color: var(--or-fonce); }
  #hall-icons{ display:flex; gap:10px; }
  .chip-btn{
    width:30px; height:30px; border-radius:50%;
    background: linear-gradient(160deg,#fff, var(--bleu-pastel-clair));
    border: 2px solid var(--or);
    display:flex; align-items:center; justify-content:center;
    font-size:14px; cursor:pointer;
    box-shadow: 0 2px 3px rgba(20,30,60,0.25);
  }
  .chip-btn:active{ transform: translateY(1px); }

  #screen-bezel{
    position:relative;
    background: var(--bleu-nuit);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 0 0 3px var(--or), inset 0 0 24px rgba(0,0,0,0.6);
  }
  #screen-inner{
    position:relative;
    width:100%;
    aspect-ratio: 3 / 2;
    background:#000;
    border-radius: 6px;
    overflow:hidden;
  }
  #game-container{ position:absolute; inset:0; }
  #game-container canvas{ width:100% !important; height:100% !important; display:block; image-rendering: pixelated; }

  #scanline-fx{
    position:absolute; inset:0; pointer-events:none;
    background:
      repeating-linear-gradient(rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px, rgba(0,0,0,0.08) 3px),
      radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(20,10,20,0.35) 100%);
    mix-blend-mode: multiply;
    opacity:.55;
  }
  #power-flicker{
    position:absolute; inset:0; background:#fff; pointer-events:none;
    animation: flicker 0.7s ease-out forwards;
  }
  @keyframes flicker{
    0%{opacity:1;} 15%{opacity:.1;} 25%{opacity:.7;} 40%{opacity:0;} 100%{opacity:0;}
  }

  /* ---- progress badge ---- */
  #progress-badge{
    position:absolute; top:8px; right:8px; z-index:20;
    background: rgba(22,33,62,0.75);
    border:1px solid var(--or);
    color: var(--or-clair);
    font-family:'Press Start 2P', monospace;
    font-size: 9px;
    padding:5px 7px;
    border-radius: 6px;
    letter-spacing:1px;
    pointer-events:none;
  }

  /* ---- interact hint bubble ---- */
  #interact-hint{
    position:absolute; z-index:21; transform:translate(-50%,-100%);
    display:none;
    background: var(--blanc);
    border:2px solid var(--or);
    border-radius: 8px;
    padding: 3px 8px;
    font-family:'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--bleu-nuit);
    white-space:nowrap;
    pointer-events:none;
    animation: bob 1.1s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{ margin-top:0px;} 50%{ margin-top:-4px;} }

  /* ---- dialogue box ---- */
  #dialogue-box{
    position:absolute; left:4%; right:4%; bottom:4%; z-index:30;
    background: linear-gradient(180deg, var(--bleu-pastel-tres-clair), var(--blanc));
    border: 3px solid var(--or);
    border-radius: 8px;
    padding: 10px 14px 12px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.45);
    cursor:pointer;
  }
  #dialogue-box.hidden{ display:none; }
  #dialogue-name{
    position:absolute; top:-14px; left:10px;
    background: var(--or);
    color: var(--bleu-nuit);
    font-family:'Press Start 2P', monospace;
    font-size:9px;
    padding:4px 8px;
    border-radius:5px;
    border:2px solid var(--bleu-nuit);
  }
  #dialogue-text{
    font-family:'VT323', monospace;
    font-size: clamp(18px, 4.2vw, 23px);
    line-height:1.55;
    letter-spacing: 0.4px;
    color: var(--encre);
    font-weight: 600;
    min-height: 3.1em;
  }
  #dialogue-cont{
    position:absolute; right:12px; bottom:8px;
    color: var(--or-fonce);
    font-size:14px;
    visibility:hidden;
  }

  /* ---- controls ---- */
  #controls{
    position:absolute; inset:0; z-index:15; pointer-events:none;
  }
  #dpad{
    position:absolute; left:14px; bottom:14px;
    width:104px; height:104px;
    pointer-events:auto;
    touch-action:none;
  }
  .dpad-btn{
    position:absolute; width:36px; height:36px;
    background: linear-gradient(160deg,#7a3f66,#4a2140);
    border:2px solid rgba(255,255,255,0.35);
    box-shadow: 0 3px 0 rgba(0,0,0,0.4);
    display:flex; align-items:center; justify-content:center;
    color:#fbdcec; font-size:14px;
    touch-action:none; -webkit-touch-callout:none;
    -webkit-user-select:none; user-select:none;
  }
  .dpad-btn:active{ background: linear-gradient(160deg,#4a2140,#34142c); transform: translateY(1px);}
  #dpad-up{ left:34px; top:0; border-radius:6px 6px 0 0;}
  #dpad-down{ left:34px; top:68px; border-radius:0 0 6px 6px;}
  #dpad-left{ left:0; top:34px; border-radius:6px 0 0 6px;}
  #dpad-right{ left:68px; top:34px; border-radius:0 6px 6px 0;}
  #dpad-mid{ left:34px; top:34px; background:#34142c; border:none; box-shadow:none;}

  #ab-buttons{
    position:absolute; right:16px; bottom:20px;
    display:flex; align-items:flex-end; gap:10px;
    pointer-events:auto;
    touch-action:none;
  }
  .round-btn{
    width:50px; height:50px; border-radius:50%;
    font-family:'Press Start 2P', monospace;
    font-size:15px;
    display:flex; align-items:center; justify-content:center;
    color: var(--bleu-nuit);
    background: radial-gradient(circle at 35% 30%, #fff, var(--or-clair) 60%, var(--or) 100%);
    border:2px solid var(--or-fonce);
    box-shadow: 0 4px 0 rgba(0,0,0,0.35);
    touch-action:none; -webkit-touch-callout:none;
    -webkit-user-select:none; user-select:none;
  }
  .round-btn:active{ transform: translateY(2px); box-shadow:0 2px 0 rgba(0,0,0,0.35); }
  #btn-b{ margin-bottom:14px; width:42px; height:42px; font-size:13px; opacity:.9;}

  /* ---- toast ---- */
  #toast{
    position:absolute; top:44px; left:50%; transform:translate(-50%,-20px);
    z-index:40; opacity:0; pointer-events:none;
    background: linear-gradient(180deg,#fffef8,#f1e6c8);
    border:2px solid var(--or-fonce);
    color: var(--bleu-nuit);
    font-family:'Press Start 2P', monospace;
    font-size:9px;
    padding:8px 12px;
    border-radius:6px;
    text-align:center;
    max-width: 80%;
    transition: transform .35s ease, opacity .35s ease;
    box-shadow:0 6px 14px rgba(0,0,0,0.35);
  }
  #toast.show{ opacity:1; transform:translate(-50%,0); }

  /* ---- pause menu ---- */
  #pause-panel, #feedback-panel{
    position:absolute; inset:0; z-index:50;
    background: rgba(15,20,40,0.72);
    display:none; align-items:center; justify-content:center;
    padding: 20px;
  }
  #pause-panel.show, #feedback-panel.show{ display:flex; }
  .panel-card{
    background: linear-gradient(180deg, var(--bleu-pastel-tres-clair), var(--blanc));
    border:3px solid var(--or);
    border-radius: 10px;
    padding: 18px;
    width:100%; max-width:340px;
    text-align:center;
  }
  .panel-card h3{
    font-family:'Press Start 2P', monospace;
    font-size: 12px;
    color: var(--bleu-nuit);
    margin: 0 0 14px;
    line-height:1.6;
  }
  .menu-btn{
    display:block; width:100%;
    font-family:'VT323', monospace; font-size:18px;
    background: var(--bleu-nuit); color: var(--blanc);
    border:2px solid var(--or); border-radius:6px;
    padding:10px; margin-bottom:10px; cursor:pointer;
  }
  .menu-btn.secondary{ background:transparent; color:var(--bleu-nuit); }
  textarea#fb-text{
    width:100%; min-height:80px; font-family:'VT323',monospace; font-size:16px;
    border:2px solid var(--or); border-radius:6px; padding:8px; resize:vertical;
  }
  #fb-stars{ font-size:26px; letter-spacing:4px; margin:8px 0; cursor:pointer; }
  #fb-stars span{ opacity:.35; }
  #fb-stars span.active{ opacity:1; }

  /* ---- ending panel ---- */
  #ending-panel{
    position:absolute; inset:0; z-index:45;
    display:none; align-items:center; justify-content:center;
    background: rgba(10,16,34,0.55);
    padding: 16px;
  }
  #ending-panel.show{ display:flex; }
  #ending-card{
    background: linear-gradient(180deg, #fffef9, var(--bleu-pastel-tres-clair));
    border:3px solid var(--or);
    border-radius:12px;
    padding: 22px 18px;
    max-width: 360px;
    width:100%;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,0.4);
  }
  #ending-card h2{
    font-family:'Press Start 2P', monospace;
    font-size:13px; color:var(--bleu-nuit); line-height:1.8; margin:0 0 12px;
  }
  #ending-card p{ font-size:18px; line-height:1.4; margin:0 0 16px; color:var(--encre);}
  .cta-btn{
    display:block; width:100%;
    font-family:'VT323', monospace; font-size:19px;
    background: linear-gradient(180deg,#233564, var(--bleu-nuit));
    color: var(--or-clair);
    border:2px solid var(--or);
    border-radius:8px;
    padding:12px; margin-bottom:10px;
    text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;
    cursor:pointer;
  }
  .cta-btn:active{ transform: translateY(1px); }

  /* ---- fiche de personnage (révélation façon RPG) ---- */
  #cv-panel{
    position:absolute; inset:0; z-index:60;
    display:none; align-items:center; justify-content:center;
    background: rgba(10,10,20,0.78);
    padding: 14px;
  }
  #cv-panel.show{ display:flex; }
  #cv-card{
    background: linear-gradient(165deg, #2c1622 0%, #4a2140 55%, #60294f 100%);
    border:3px solid var(--or);
    border-radius:14px;
    padding: 18px 16px 16px;
    max-width: 380px;
    width:100%;
    max-height: 92%;
    overflow-y:auto;
    box-shadow: 0 0 0 4px rgba(127,174,142,0.25), 0 14px 40px rgba(0,0,0,0.55);
    color: var(--blanc);
    opacity:0; transform:scale(0.9);
    transition: opacity .35s ease, transform .35s ease;
  }
  #cv-panel.show #cv-card{ opacity:1; transform:scale(1); }
  #cv-card h2{
    font-family:'Press Start 2P', monospace; font-size:12px;
    text-align:center; color:#c3e4cf; line-height:1.7; margin:0 0 4px;
    text-shadow:0 0 8px rgba(127,174,142,0.6);
  }
  #cv-card .cv-sub{
    text-align:center; font-size:15px; color:#f2b8d4; margin:0 0 14px;
  }
  .cv-stat{
    margin-bottom:10px; opacity:0; transform:translateX(-14px);
    transition: opacity .4s ease, transform .4s ease;
  }
  .cv-stat.on{ opacity:1; transform:translateX(0); }
  .cv-stat-label{
    display:flex; justify-content:space-between; align-items:baseline;
    font-family:'VT323', monospace; font-size:16px; margin-bottom:3px;
  }
  .cv-stat-label span:last-child{ color:#c3e4cf; font-size:13px; }
  .cv-bar-track{
    height:10px; border-radius:5px; background:rgba(255,255,255,0.12);
    border:1px solid rgba(255,255,255,0.25); overflow:hidden;
  }
  .cv-bar-fill{
    height:100%; width:0%; border-radius:5px;
    background: linear-gradient(90deg, #7fae8e, #c3e4cf);
    transition: width 1s cubic-bezier(.2,.9,.3,1);
    box-shadow: 0 0 8px rgba(127,174,142,0.7);
  }
  #cv-badges{
    display:flex; flex-wrap:wrap; gap:6px; justify-content:center;
    margin: 12px 0 6px;
  }
  .cv-badge{
    font-family:'Press Start 2P', monospace; font-size:8px;
    background: rgba(255,255,255,0.08);
    border:2px solid #c9a24b; color:#fdeef7;
    border-radius:8px; padding:6px 8px;
    display:flex; align-items:center; gap:5px;
    opacity:0; transform: scale(0.4) rotate(-8deg);
    transition: opacity .35s ease, transform .35s cubic-bezier(.3,1.6,.5,1);
  }
  .cv-badge.on{ opacity:1; transform: scale(1) rotate(0deg); }
  #cv-quote{
    text-align:center; font-size:17px; line-height:1.4; color:#fbdcec;
    margin: 12px 0 14px; opacity:0; transition: opacity .6s ease;
    font-style: italic;
  }
  #cv-quote.on{ opacity:1; }
  #cv-panel .cta-btn{ margin-bottom:8px; }
  #cv-pdf-link{
    display:block; text-align:center; font-family:'VT323',monospace;
    font-size:14px; color: rgba(255,255,255,0.55); text-decoration:underline;
    margin-top:4px; opacity:0; transition: opacity .6s ease;
  }
  #cv-pdf-link.on{ opacity:1; }
  .contact-info-block{
    margin-top:12px; padding:10px 12px; border-radius:10px;
    background: rgba(255,255,255,0.12); border:1px dashed rgba(255,255,255,0.4);
    font-family:'VT323',monospace; font-size:16px; line-height:1.5;
    text-align:center; color:#fffaf9; user-select:text;
  }
  .contact-info-block .ci-label{ opacity:0.75; font-size:13px; letter-spacing:0.5px; }
  .contact-info-block .ci-value{ font-size:18px; font-weight:bold; }
  .cv-sparkle{
    position:absolute; pointer-events:none; font-size:16px;
    animation: cvSparkle 900ms ease-out forwards;
  }
  @keyframes cvSparkle{
    0%{ transform:translateY(0) scale(0.4); opacity:1; }
    100%{ transform:translateY(-40px) scale(1.1); opacity:0; }
  }

  #footer-note{
    text-align:center; font-size:12px; color: rgba(20,30,60,0.55);
    margin-top:8px; font-family:'VT323',monospace;
  }
</style>
</head>
<body>
<div id="stage">
  <div id="console-shell">
    <div id="brand-row">
      <div id="brand">LE <span>BUREAU</span> 577</div>
      <div id="hall-icons">
        <div class="chip-btn" id="btn-mute" title="Son">🔊</div>
        <div class="chip-btn" id="btn-pause" title="Menu">☰</div>
      </div>
    </div>
    <div id="screen-bezel">
      <div id="screen-inner">
        <div id="game-container"></div>
        <div id="scanline-fx"></div>
        <div id="power-flicker"></div>

        <div id="progress-badge">0 / 3 NIVEAUX</div>
        <div id="interact-hint">A</div>

        <div id="dialogue-box" class="hidden">
          <div id="dialogue-name">—</div>
          <div id="dialogue-text"></div>
          <div id="dialogue-cont">▼</div>
        </div>

        <div id="controls">
          <div id="dpad">
            <div class="dpad-btn" id="dpad-up">▲</div>
            <div class="dpad-btn" id="dpad-down">▼</div>
            <div class="dpad-btn" id="dpad-left">◀</div>
            <div class="dpad-btn" id="dpad-right">▶</div>
            <div class="dpad-btn" id="dpad-mid"></div>
          </div>
          <div id="ab-buttons">
            <div class="round-btn" id="btn-b">B</div>
            <div class="round-btn" id="btn-a">A</div>
          </div>
        </div>

        <div id="toast"></div>

        <div id="pause-panel">
          <div class="panel-card">
            <h3>MENU</h3>
            <div class="menu-btn" id="pause-resume">Reprendre</div>
            <div class="menu-btn" id="pause-hub">Retour au Hall principal</div>
            <div class="menu-btn secondary" id="pause-restart">Recommencer depuis le début</div>
          </div>
        </div>

        <div id="feedback-panel">
          <div class="panel-card">
            <h3>UNE QUESTION ?<br>UN AVIS ?</h3>
            <div id="fb-stars">
              <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
            </div>
            <textarea id="fb-text" placeholder="Avez-vous des questions ? Qu'avez-vous pensé de cette interface ?"></textarea>
            <div class="menu-btn" id="fb-send" style="margin-top:10px;">Envoyer par e-mail</div>
            <div class="menu-btn secondary" id="fb-cancel">Annuler</div>
          </div>
        </div>

        <div id="ending-panel">
          <div id="ending-card">
            <h2>MERCI DE VOTRE VISITE</h2>
            <p id="ending-text">Ce Bureau 577 n'était pas un CV. C'était une invitation à me découvrir autrement — pour un stage qui compte vraiment pour moi.</p>
            <div class="cta-btn" id="cta-cv">🎮 Débloquer ma fiche de personnage</div>
            <div class="cta-btn" id="cta-contact">✉️ Me contacter</div>
            <div class="cta-btn" id="cta-feedback">💬 Vos questions / votre avis</div>
            <div id="contact-info-block"></div>
          </div>
        </div>

        <div id="cv-panel">
          <div id="cv-card">
            <h2>✦ FICHE DÉBLOQUÉE ✦</h2>
            <div class="cv-sub">Dounia — Candidate, Bureau 577</div>

            <div class="cv-stat" data-w="96"><div class="cv-stat-label"><span>🎤 Éloquence</span><span>96</span></div><div class="cv-bar-track"><div class="cv-bar-fill"></div></div></div>
            <div class="cv-stat" data-w="92"><div class="cv-stat-label"><span>🌍 Langues (EN / AR)</span><span>92</span></div><div class="cv-bar-track"><div class="cv-bar-fill"></div></div></div>
            <div class="cv-stat" data-w="90"><div class="cv-stat-label"><span>🤝 Leadership associatif</span><span>90</span></div><div class="cv-bar-track"><div class="cv-bar-fill"></div></div></div>
            <div class="cv-stat" data-w="88"><div class="cv-stat-label"><span>📣 Communication</span><span>88</span></div><div class="cv-bar-track"><div class="cv-bar-fill"></div></div></div>
            <div class="cv-stat" data-w="85"><div class="cv-stat-label"><span>🛠️ Polyvalence terrain</span><span>85</span></div><div class="cv-bar-track"><div class="cv-bar-fill"></div></div></div>

            <div id="cv-badges">
              <div class="cv-badge">🏅 3× 1er prix CNRD</div>
              <div class="cv-badge">🏆 3e national Batissiel</div>
              <div class="cv-badge">🎓 Licence LEA angl.-arabe</div>
              <div class="cv-badge">👑 Présidente d'association</div>
              <div class="cv-badge">🌐 Vocation Moyen-Orient</div>
            </div>

            <div id="cv-quote">« Ce que vous venez de voir dans ce Bureau, c'est ce qui ne tient pas sur une page A4. »</div>

            <div class="cta-btn" id="cta-contact-2">✉️ Me contacter</div>
            <div class="cta-btn secondary-cta" id="cv-close" style="background:transparent;border:2px solid rgba(255,255,255,0.4);">Revenir</div>
            <a id="cv-pdf-link" href="#" target="_blank" rel="noopener">Voir mon CV complet en PDF</a>
            <div id="contact-info-block-2"></div>
          </div>
        </div>

      </div>
    </div>
    <div id="footer-note">Flèches / D-Pad pour se déplacer · A pour interagir</div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/phaser@3.80.1/dist/phaser.min.js"></script>
<script>
/* =========================================================================
   LE BUREAU 577 — jeu narratif pixel-art (candidature vivante)
   ========================================================================= */

/* -------------------------------------------------------------------------
   0. CONFIGURATION — à personnaliser
   ------------------------------------------------------------------------- */
const CONFIG = {
  candidateName: "Dounia",
  email: "benotsmanedounia@gmail.com",
  phone: "06 41 45 08 41",
  website: "https://example.com",    // TODO: URL du site personnel
  cvUrl: "/_blob/9216e590b50493ba05622d703b533cae",
};

/* -------------------------------------------------------------------------
