function bindHold(id, key){
  const el = document.getElementById(id);
  el.style.touchAction = 'none';
  const on = (e)=>{
    e.preventDefault();
    ensureAudio(); playClick();
    keys[key]=true;
    try{ el.setPointerCapture(e.pointerId); }catch(err){}
  };
  const off = (e)=>{ if(e) e.preventDefault(); keys[key]=false; };
  el.addEventListener('pointerdown', on);
  el.addEventListener('pointerup', off);
  el.addEventListener('pointerleave', off);
  el.addEventListener('pointercancel', off);
  el.addEventListener('lostpointercapture', off);
  el.addEventListener('contextmenu', e=> e.preventDefault());
}
bindHold('dpad-up','up'); bindHold('dpad-down','down');
bindHold('dpad-left','left'); bindHold('dpad-right','right');

window.addEventListener('keydown', (e)=>{
  const k = e.key;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(k)) e.preventDefault();
  if(k==='ArrowUp'||k==='w'||k==='W') keys.up = true;
  if(k==='ArrowDown'||k==='s'||k==='S') keys.down = true;
  if(k==='ArrowLeft'||k==='a'||k==='A') keys.left = true;
  if(k==='ArrowRight'||k==='d'||k==='D') keys.right = true;
  if(k===' '||k==='Enter'||k==='e'||k==='E') pressA();
  if(k==='Escape') pressB();
});
window.addEventListener('keyup', (e)=>{
  const k = e.key;
  if(k==='ArrowUp'||k==='w'||k==='W') keys.up = false;
  if(k==='ArrowDown'||k==='s'||k==='S') keys.down = false;
  if(k==='ArrowLeft'||k==='a'||k==='A') keys.left = false;
  if(k==='ArrowRight'||k==='d'||k==='D') keys.right = false;
});

