/* ---- Dialogue système ---- */
let dq = [];
let curLine = '';
let curCharIndex = 0;
let typingTimer = null;
let onDialogueDone = null;

function openDialogue(speaker, lines, onDone){
  dialogueActive = true;
  onDialogueDone = onDone || null;
  dq = lines.slice();
  els.dialogueName.textContent = speaker;
  els.dialogueBox.classList.remove('hidden');
  nextLine();
}
function nextLine(){
  if(dq.length === 0){ closeDialogue(); return; }
  curLine = dq.shift();
  curCharIndex = 0;
  els.dialogueText.textContent = '';
  els.dialogueCont.style.visibility = 'hidden';
  clearInterval(typingTimer);
  typingTimer = setInterval(()=>{
    curCharIndex++;
    els.dialogueText.textContent = curLine.slice(0, curCharIndex);
    if(curCharIndex % 3 === 0) playBlip();
    if(curCharIndex >= curLine.length){
      clearInterval(typingTimer);
      els.dialogueCont.style.visibility = 'visible';
    }
  }, 20);
}
function completeCurrentLine(){
  clearInterval(typingTimer);
  curCharIndex = curLine.length;
  els.dialogueText.textContent = curLine;
  els.dialogueCont.style.visibility = 'visible';
}
function advanceDialogue(){
  if(curCharIndex < curLine.length){ completeCurrentLine(); }
  else { nextLine(); }
}
function closeDialogue(){
  dialogueActive = false;
  els.dialogueBox.classList.add('hidden');
  const cb = onDialogueDone; onDialogueDone = null;
  if(cb) cb();
}
els.dialogueBox.addEventListener('click', advanceDialogue);

