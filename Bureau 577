/* ---- Contact : envoi réel par mail (relais) + copie de l'adresse en secours ---- */
function doContact(){
  playClick();
  sendMailRelay({
    _subject: 'Contact — Le Bureau 577',
    'Message': "Un visiteur souhaite être recontacté après avoir terminé Le Bureau 577."
  });
  let copied = false;
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(CONFIG.email);
      copied = true;
    }
  }catch(e){}
  if(!copied){
    try{
      const ta = document.createElement('textarea');
      ta.value = CONFIG.email; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      copied = true;
    }catch(e){}
  }
  showToast(`✉️ Message envoyé ! Mon adresse (${copied?'copiée':'ci-contre'}) : ${CONFIG.email}`);
}
document.getElementById('cta-contact').addEventListener('click', doContact);
document.getElementById('cta-contact-2').addEventListener('click', doContact);

/* ---- Fiche de personnage : révélation façon RPG (remplace le "téléchargement" du CV) ---- */
function spawnSparkles(el, count){
  const rect = el.getBoundingClientRect();
  const cardRect = els.cvPanel.querySelector('#cv-card').getBoundingClientRect();
  const icons = ['✦','✧','★','·'];
  for(let i=0;i<count;i++){
    const s = document.createElement('div');
    s.className = 'cv-sparkle';
    s.textContent = icons[Math.floor(Math.random()*icons.length)];
    s.style.left = (rect.left - cardRect.left + rect.width*Math.random()) + 'px';
    s.style.top = (rect.top - cardRect.top + rect.height*0.4) + 'px';
    s.style.color = Math.random()>0.5 ? '#c3e4cf' : '#f2b8d4';
    els.cvPanel.querySelector('#cv-card').appendChild(s);
    setTimeout(()=> s.remove(), 950);
  }
}
function showCvReveal(){
  playClick();
  fillContactInfoBlocks();
  els.cvPanel.classList.add('show');
  const stats = Array.from(document.querySelectorAll('.cv-stat'));
  const badges = Array.from(document.querySelectorAll('.cv-badge'));
  const quote = document.getElementById('cv-quote');
  const pdfLink = document.getElementById('cv-pdf-link');

  stats.forEach(s=>{ s.classList.remove('on'); s.querySelector('.cv-bar-fill').style.width = '0%'; });
  badges.forEach(b=> b.classList.remove('on'));
  quote.classList.remove('on');
  pdfLink.classList.remove('on');

  ensureAudio();
  let t = 150;
  stats.forEach((s, i)=>{
    setTimeout(()=>{
      s.classList.add('on');
      s.querySelector('.cv-bar-fill').style.width = s.dataset.w + '%';
      playBlip();
    }, t);
    t += 260;
  });
  t += 150;
  badges.forEach((b, i)=>{
    setTimeout(()=>{
      b.classList.add('on');
      playChime();
      spawnSparkles(b, 4);
    }, t);
    t += 220;
  });
  t += 250;
  setTimeout(()=>{
    quote.classList.add('on');
    pdfLink.classList.add('on');
    playBadge();
  }, t);
}
document.getElementById('cta-cv').addEventListener('click', showCvReveal);
