/* ---- Musique d'ambiance en boucle : petite mélodie chiptune + basse,
   avec un planificateur "look-ahead" pour un vrai tempo régulier ---- */
const AMBIENT_BPM = 96;
const AMBIENT_BEAT_SEC = 60 / AMBIENT_BPM;
const AMBIENT_LOOP_BEATS = 8;
const AMBIENT_MELODY = [
  { beat:0, freq:523.25, dur:0.85 },
  { beat:1, freq:659.25, dur:0.85 },
  { beat:2, freq:784.00, dur:0.85 },
  { beat:3, freq:659.25, dur:0.85 },
  { beat:4, freq:587.33, dur:0.85 },
  { beat:5, freq:698.46, dur:0.85 },
  { beat:6, freq:880.00, dur:0.85 },
  { beat:7, freq:698.46, dur:0.85 },
];
const AMBIENT_BASS = [
  { beat:0, freq:261.63, dur:1.8 },
  { beat:2, freq:220.00, dur:1.8 },
  { beat:4, freq:293.66, dur:1.8 },
  { beat:6, freq:349.23, dur:1.8 },
];
let ambientRunning = false;
let ambientSchedulerId = null;
let ambientNextTime = 0;
let ambientBeatIndex = 0;
function scheduleAmbientNotes(){
  const ctx = ensureAudio();
  while(ambientNextTime < ctx.currentTime + 0.22){
    const b = ambientBeatIndex % AMBIENT_LOOP_BEATS;
    const delay = Math.max(0, ambientNextTime - ctx.currentTime);
    AMBIENT_MELODY.filter(n=> n.beat===b).forEach(n=>{
      beep(n.freq, n.dur*AMBIENT_BEAT_SEC, 'square', 0.05, delay);
    });
    AMBIENT_BASS.filter(n=> n.beat===b).forEach(n=>{
      beep(n.freq, n.dur*AMBIENT_BEAT_SEC, 'sine', 0.07, delay);
    });
    ambientNextTime += AMBIENT_BEAT_SEC;
    ambientBeatIndex++;
  }
}
function startAmbient(){
  if(ambientRunning || muted) return;
  ambientRunning = true;
  const ctx = ensureAudio();
  ambientNextTime = ctx.currentTime + 0.05;
  ambientBeatIndex = 0;
  scheduleAmbientNotes();
  ambientSchedulerId = setInterval(()=>{ if(!muted) scheduleAmbientNotes(); }, 120);
}
function stopAmbient(){
  ambientRunning = false;
  clearInterval(ambientSchedulerId);
  ambientSchedulerId = null;
}
/* Filet de sécurité : si l'audio n'a pas pu démarrer plus tôt (politique du
   navigateur), la toute première interaction de l'utilisateur la déclenche. */
function primeAmbientOnce(){
  ensureAudio();
  startAmbient();
  window.removeEventListener('pointerdown', primeAmbientOnce);
  window.removeEventListener('keydown', primeAmbientOnce);
  window.removeEventListener('touchstart', primeAmbientOnce);
}
window.addEventListener('pointerdown', primeAmbientOnce, { once:true });
window.addEventListener('keydown', primeAmbientOnce, { once:true });
window.addEventListener('touchstart', primeAmbientOnce, { once:true });

