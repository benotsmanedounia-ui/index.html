    // PNJ candidate
    this.npc = this.add.sprite(W/2, 170, 'candidate_front_0').setDepth(4);
    this.tweens.add({ targets:this.npc, y:'+=4', duration:900, yoyo:true, repeat:-1, ease:'Sine.InOut' });
    this.npcZone = new Phaser.Geom.Circle(this.npc.x, this.npc.y, 34);

    // joueur
    this.player = createPlayer(this, W/2, H-70);

    this.hintShown = false;

    const onInteract = ()=>{
      if(this.scene.isSleeping() || !this.scene.isActive()) return;
      this.tryInteract();
    };
    gameEvents.on('interact', onInteract);
    this.events.on('shutdown', ()=> gameEvents.off('interact', onInteract));

    if(!this.registry.get('metCandidate')){
      this.time.delayedCall(300, ()=>{
        openDialogue(N(), [
          "Bienvenue.",
          "Plutôt que de vous faire lire mon CV, j'ai préféré vous le faire vivre.",
          "Ce Bureau 577 rassemble ce qui compte le plus dans mon parcours : le terrain, la rigueur, et une conviction obstinée pour l'intérêt général.",
          "Chaque niveau raconte une étape. Approchez-vous d'une porte et appuyez sur A pour entrer — prenez le temps que vous voulez, je serai là pour vous guider.",
          "Quand vous aurez tout exploré, revenez me voir : une dernière porte s'ouvrira, tout au fond du hall."
        ]);
        this.registry.set('metCandidate', true);
      });
    }
  }
  redrawFinalDoor(){
    const complete = completedRoomsCount() >= ROOM_ORDER.length;
    this.finalGfx.clear();
    const r = this.finalDoorRect;
    this.finalGfx.fillStyle(complete ? 0x7fae8e : 0x3a4568, 1);
    this.finalGfx.fillRect(r.x, r.y, r.width, r.height);
    this.finalGfx.fillStyle(0x4a2140,1);
    this.finalGfx.fillRect(r.x+6, r.y+4, r.width-12, r.height-6);
    this.finalLabel.setColor(complete ? '#c3e4cf' : '#8a7a86');
    this.finalLabel.setText(complete ? '✦ Bureau du Président ✦' : 'Bureau du Président (verrouillé)');
    if(complete && !this.sparkleAdded){
      this.sparkleAdded = true;
      this.tweens.add({ targets:this.finalGfx, alpha:{from:0.7,to:1}, duration:700, yoyo:true, repeat:-1 });
    }
  }
  buildRoomDoor(d){
    const complete = isRoomComplete(d.key);
    const g = this.add.graphics().setDepth(2);
    g.fillStyle(complete ? 0x7fae8e : 0xb96f93, 1);
    g.fillRoundedRect(d.x-24, d.y-16, 48, 30, 4);
    g.fillStyle(0x4a2140,1);
    g.fillRoundedRect(d.x-18, d.y-10, 36, 24, 3);
    const icon = this.add.image(d.x, d.y+1, 'icon_' + (ROOMS[d.key].hotspots[0].icon)).setDepth(3).setScale(0.9);
    this.add.text(d.x, d.y+22, d.label + (complete?' ✓':''), {
      fontFamily:'"Press Start 2P"', fontSize:'6.5px', color: complete? '#c3e4cf':'#fdeef7',
      letterSpacing:0.5, stroke:'#2c1622', strokeThickness:3
    }).setOrigin(0.5,0).setDepth(3);
    this.doors.push({ key:d.key, x:d.x, y:d.y-2 });
  }
  nearestDoor(){
    let best=null, bestD=48;
    for(const d of this.doors){
      const dist = Phaser.Math.Distance.Between(this.player.x, this.player.y, d.x, d.y);
      if(dist < bestD){ bestD = dist; best = d; }
    }
    const allDone = completedRoomsCount() >= ROOM_ORDER.length;
    if(allDone){
      const distF = Phaser.Math.Distance.Between(this.player.x, this.player.y, this.finalDoorPoint.x, this.finalDoorPoint.y);
      if(distF < bestD){ bestD = distF; best = { key:'__final__', x:this.finalDoorPoint.x, y:this.finalDoorPoint.y }; }
    }
    return best;
  }
  tryInteract(){
    if(Phaser.Geom.Circle.ContainsPoint(this.npcZone, this.player)){
      const allDone = completedRoomsCount() >= ROOM_ORDER.length;
      if(allDone){
        openDialogue(N(), [
          "Bravo, vous avez parcouru tous ces niveaux — c'est top, vraiment !",
          "Il ne vous reste plus qu'une chose à faire : passez la porte tout au fond du hall, mon Bureau vous y attend."
        ]);
      } else {
        openDialogue(N(), [
          "N'hésitez pas à visiter les trois niveaux : Études, Expérience, puis Concrétisation de mes projets.",
          "Approchez-vous d'une porte et appuyez sur A pour entrer. Chacune raconte une facette différente de mon parcours."
        ]);
      }
      return;
    }
    const d = this.nearestDoor();
    if(d){
      if(d.key === '__final__'){
        ensureAudio(); playDoor();
        this.cameras.main.fadeOut(450,0,0,0);
        this.cameras.main.once('camerafadeoutcomplete', ()=> this.scene.start('Ending'));
      } else {
        this.enterRoom(d.key);
      }
    }
  }
  update(time, delta){
    updatePlayerMovement(this, this.player, delta);
    this.npcZone.x = this.npc.x; this.npcZone.y = this.npc.y;

    const nearNpc = Phaser.Geom.Circle.ContainsPoint(this.npcZone, this.player);
    const d = nearNpc ? null : this.nearestDoor();
    if(dialogueActive){ hideInteractHint(); return; }
    if(nearNpc){
      showInteractHint(this, this.npc.x, this.npc.y-30);
    } else if(d){
      showInteractHint(this, d.x, d.y-22);
    } else {
      hideInteractHint();
    }
  }
  enterRoom(key){
    ensureAudio(); playDoor();
    this.cameras.main.fadeOut(350,0,0,0);
    this.cameras.main.once('camerafadeoutcomplete', ()=>{
      this.scene.start('Room', { roomKey:key });
    });
  }
}

class RoomScene extends Phaser.Scene{
  constructor(){ super('Room'); }
  init(data){ this.roomKey = data.roomKey; }
  create(){
    const cfg = ROOMS[this.roomKey];
    this.cameras.main.fadeIn(350,0,0,0);
    buildFloor(this, cfg.floorTint || 0xfbdcec);
    buildWalls(this, cfg.title);
    buildExitDoor(this, 'Retour au Hall');
    this.exitPoint = { x: W/2, y: H-24 };

    this.player = createPlayer(this, W/2, H-70);

    this.hotspotSprites = cfg.hotspots.map((h, idx)=>{
      const s = this.add.image(h.x, h.y, 'icon_' + h.icon).setDepth(4).setScale(1.3);
      s.hotData = h;
      this.tweens.add({ targets:s, y:h.y-4, duration:800+Math.random()*300, yoyo:true, repeat:-1, ease:'Sine.InOut' });
      this.add.text(h.x, h.y+16, h.label, {
        fontFamily:'"Press Start 2P"', fontSize:'6px', color:'#fffaf9',
        letterSpacing:0.5, stroke:'#2c1622', strokeThickness:3,
        align:'center', wordWrap:{ width:120, useAdvancedWrap:true }
      }).setOrigin(0.5,0).setDepth(4);

      // pastille de cheminement : indique l'ordre suggéré de visite
      const doneAlready = roomState[this.roomKey].done.has(h.id);
      const badgeBg = this.add.circle(h.x-15, h.y-15, 9, doneAlready ? 0x7fae8e : 0xb96f93).setDepth(6);
      badgeBg.setStrokeStyle(2, 0x2c1622);
      const badgeTxt = this.add.text(h.x-15, h.y-15, doneAlready ? '✓' : String(idx+1), {
        fontFamily:'"Press Start 2P"', fontSize:'8px', color:'#fffaf9'
      }).setOrigin(0.5).setDepth(7);
      s.__badgeBg = badgeBg; s.__badgeTxt = badgeTxt;
      if(doneAlready){ s.__marked = true; }
      return s;
    });

    const onInteract = ()=> this.tryInteract();
    gameEvents.on('interact', onInteract);
    this.events.on('shutdown', ()=> gameEvents.off('interact', onInteract));

    if(cfg.intro){
      this.time.delayedCall(250, ()=>{
        openDialogue(N(), [cfg.intro]);
      });
    }
  }
  nearestHotspot(){
    let best=null, bestD=48;
    for(const s of this.hotspotSprites){
      const d = Phaser.Math.Distance.Between(this.player.x, this.player.y, s.x, s.y);
      if(d < bestD){ bestD = d; best = s; }
    }
    return best;
  }
  exitDistance(){
    return Phaser.Math.Distance.Between(this.player.x, this.player.y, this.exitPoint.x, this.exitPoint.y);
  }
  nearExit(){ return this.exitDistance() < 54; }
  /* Choisit ce qui est réellement le plus proche entre un point d'intérêt et
     la sortie, pour qu'un point d'intérêt trop proche de la porte ne puisse
     plus jamais bloquer la sortie du joueur. */
  nearestTarget(){
    let best=null, bestD=48;
    for(const s of this.hotspotSprites){
      const d = Phaser.Math.Distance.Between(this.player.x, this.player.y, s.x, s.y);
      if(d < bestD){ bestD = d; best = { type:'hotspot', sprite:s }; }
    }
    const dExit = this.exitDistance();
    if(dExit < 54 && dExit < bestD){ best = { type:'exit' }; }
    return best;
  }
  tryInteract(){
    const target = this.nearestTarget();
    if(!target) return;
    if(target.type === 'hotspot'){
      const s = target.sprite;
      const h = s.hotData;
      openDialogue(N(), h.lines.slice(), ()=>{
        markHotspotDone(this.roomKey, h.id);
        if(!s.__marked){
          s.__marked = true;
          if(s.__badgeBg) s.__badgeBg.setFillStyle(0x7fae8e);
          if(s.__badgeTxt) s.__badgeTxt.setText('✓');
        }
        if(typeof h.onDone === 'function') h.onDone();
      });
      return;
    }
    ensureAudio(); playDoor();
    this.cameras.main.fadeOut(300,0,0,0);
    this.cameras.main.once('camerafadeoutcomplete', ()=> this.scene.start('Hub'));
  }
  update(time, delta){
    updatePlayerMovement(this, this.player, delta);

    if(dialogueActive){ hideInteractHint(); return; }

    const target = this.nearestTarget();
    if(target && target.type === 'hotspot'){ showInteractHint(this, target.sprite.x, target.sprite.y-24); }
    else if(target && target.type === 'exit'){ showInteractHint(this, this.exitPoint.x, this.exitPoint.y-14); }
    else { hideInteractHint(); }
  }
}

class EndingScene extends Phaser.Scene{
  constructor(){ super('Ending'); }
  create(){
    this.cameras.main.fadeIn(500,0,0,0);
    buildFloor(this, 0xf1e6c8);
    buildWalls(this, 'Bureau du Président');

    // grand bureau
    const g = this.add.graphics().setDepth(3);
    g.fillStyle(0x4a3a2c,1); g.fillRect(W/2-90, 190, 180, 60);
    g.fillStyle(0x7fae8e,1); g.fillRect(W/2-90, 190, 180, 6);

    this.npc = this.add.sprite(W/2, 165, 'candidate_front_0').setDepth(4).setScale(1.15);
    this.tweens.add({ targets:this.npc, y:'+=4', duration:900, yoyo:true, repeat:-1, ease:'Sine.InOut' });

    ensureAudio();
    stopAmbient();
    playVictory();
    this.time.delayedCall(1300, ()=> playOutro());
    this.time.delayedCall(4700, ()=> startAmbient());

    this.time.delayedCall(400, ()=>{
      openDialogue(N(), [
        "Bravo, vous avez parcouru tous ces niveaux — c'est vraiment top !",
        "Merci d'avoir pris le temps de me découvrir autrement qu'à travers une page de CV.",
        "Ce que vous avez vu ici, c'est ce qui me donne envie, chaque jour, de m'investir pour l'intérêt général.",
        "Je vous le dis simplement : ce stage compte énormément pour moi. C'est ce qu'il me faut pour valider ma troisième année, et j'ai vraiment envie de le faire dans un domaine que j'apprécie.",
        "J'espère sincèrement que ma candidature sera retenue, et pouvoir continuer cette histoire à vos côtés.",
        "Avant de partir : avez-vous des questions ? Et qu'avez-vous pensé de cette interface ? N'hésitez pas à me le dire juste en dessous."
      ], ()=>{ showEndingPanel(); });
    });
  }
}

/* -------------------------------------------------------------------------
   6. HINT D'INTERACTION (positionnement écran depuis coord. monde)
   ------------------------------------------------------------------------- */
let hintScene = null;
function showInteractHint(scene, worldX, worldY){
  hintScene = scene;
  const rect = els.screenInner.getBoundingClientRect();
  const scaleX = rect.width / W, scaleY = rect.height / H;
  els.interactHint.style.left = (worldX*scaleX) + 'px';
  els.interactHint.style.top = (worldY*scaleY) + 'px';
  els.interactHint.style.display = 'block';
}
function hideInteractHint(){ els.interactHint.style.display = 'none'; }

/* -------------------------------------------------------------------------
   7. CONFIG PHASER & LANCEMENT
   ------------------------------------------------------------------------- */
const gameConfig = {
  type: Phaser.AUTO,
  width: W,
  height: H,
  parent: 'game-container',
  backgroundColor: '#2c1622',
  pixelArt: true,
  roundPixels: true,
  scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH },
  scene: [PreloadScene, DeskIntroScene, LogoScene, HubScene, RoomScene, EndingScene],
};
window.__game = new Phaser.Game(gameConfig);

setTimeout(()=>{ const pf = document.getElementById('power-flicker'); if(pf) pf.remove(); }, 900);
</script>
