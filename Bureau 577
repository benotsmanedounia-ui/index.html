  sendMailRelay({
    _subject: 'Avis — Le Bureau 577',
    'Note': `${fbRating || '-'}/5 (${stars})`,
    'Avis / question': text || '(aucun commentaire)'
  });
  els.feedbackPanel.classList.remove('show');
  showToast('Merci ! Votre avis vient d\'être envoyé.');
});

