const W = 480, H = 320;
const ROOM_BOUNDS = { left: 46, right: W-46, top: 96, bottom: H-34 };

function buildFloor(scene, tint){
  scene.add.grid(W/2, H/2, W, H, 24, 24, tint, 1, 0x000000, 0.05).setDepth(0);
  const g = scene.add.graphics().setDepth(0);
  g.fillStyle(0x000000, 0.05);
  g.fillRect(0,0,W,ROOM_BOUNDS.top-4);
  g.fillRect(0,ROOM_BOUNDS.bottom+4,W,H-ROOM_BOUNDS.bottom-4);
