}

function createPlayer(scene, x, y){
  const p = scene.add.sprite(x, y, 'player_front_0').setDepth(5);
  p.dir = 'front'; p.frame2 = 0; p.moving = false; p.animTimer = 0;
  return p;
}
function setPlayerTexture(p, dir, frame){
  const map = { front:'player_front_', back:'player_back_', left:'player_side_', right:'player_side_' };
  p.setTexture(map[dir] + frame);
  p.setFlipX(dir === 'right');
}

function updatePlayerMovement(scene, p, delta){
  if(dialogueActive){ p.moving=false; return; }
  let vx=0, vy=0;
  if(keys.up) vy -= 1;
  if(keys.down) vy += 1;
  if(keys.left) vx -= 1;
  if(keys.right) vx += 1;
  const moving = (vx!==0 || vy!==0);
  if(moving){
    const len = Math.hypot(vx,vy) || 1;
    vx/=len; vy/=len;
    const speed = 108;
    p.x = Phaser.Math.Clamp(p.x + vx*speed*(delta/1000), ROOM_BOUNDS.left, ROOM_BOUNDS.right);
    p.y = Phaser.Math.Clamp(p.y + vy*speed*(delta/1000), ROOM_BOUNDS.top, ROOM_BOUNDS.bottom);
    if(Math.abs(vx) > Math.abs(vy)) p.dir = vx>0 ? 'right':'left';
    else p.dir = vy>0 ? 'front':'back';
    p.animTimer += delta;
    if(p.animTimer > 160){ p.animTimer=0; p.frame2 = p.frame2 ? 0 : 1; }
  } else {
    p.frame2 = 0;
  }
  p.moving = moving;
  setPlayerTexture(p, p.dir, p.frame2);
}

