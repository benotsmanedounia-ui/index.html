   3. GÉNÉRATION DES TEXTURES (pixel-art procédural)
   ------------------------------------------------------------------------- */
function makePersonTexture(scene, key, palette, dir, frame){
  const w=32, h=48;
  if(scene.textures.exists(key)) return;
  const tex = scene.textures.createCanvas(key, w, h);
  const ctx = tex.getContext();
  ctx.imageSmoothingEnabled = false;
  ctx.clearRect(0,0,w,h);
  const cx = w/2;
  // ombre
  ctx.fillStyle = 'rgba(15,20,40,0.28)';
  ctx.beginPath(); ctx.ellipse(cx, h-4, 9, 3, 0, 0, Math.PI*2); ctx.fill();
  // jambes
  const legOff = frame===1 ? 2 : 0;
  ctx.fillStyle = palette.legs;
  ctx.fillRect(cx-7, h-17, 6, 12-legOff);
  ctx.fillRect(cx+1, h-17+legOff, 6, 12-legOff);
  // bras
  ctx.fillStyle = palette.body;
  ctx.fillRect(cx-13, h-31, 4, 14);
  ctx.fillRect(cx+9, h-31, 4, 14);
  // corps (tenue sobre)
  ctx.fillStyle = palette.body;
  ctx.fillRect(cx-10, h-33, 20, 18);
  // ceinture fine (détail sobre, sans cravate)
  ctx.fillStyle = palette.accent;
  ctx.fillRect(cx-10, h-19, 20, 2);
  // cheveux longs — mèches derrière les épaules (dessinées avant la tête)
  ctx.fillStyle = palette.hair;
  ctx.fillRect(cx-10, h-46, 3, 19);
  ctx.fillRect(cx+7, h-46, 3, 19);
  // tete
  ctx.fillStyle = palette.skin;
  ctx.fillRect(cx-8, h-47, 16, 16);
  // cheveux (mèche du dessus + visage)
  ctx.fillStyle = palette.hair;
  if(dir==='back'){
    ctx.fillRect(cx-10, h-48, 20, 21);
  } else {
    ctx.fillRect(cx-9, h-48, 18, 7);
    if(dir==='left'){ ctx.fillRect(cx-9, h-47, 5, 15); ctx.fillStyle=palette.eye; ctx.fillRect(cx-6,h-40,3,3); }
    else if(dir==='right'){ ctx.fillRect(cx+4, h-47, 5, 15); ctx.fillStyle=palette.eye; ctx.fillRect(cx+3,h-40,3,3); }
    else {
      ctx.fillStyle=palette.eye;
      ctx.fillRect(cx-6,h-41,3,3);
      ctx.fillRect(cx+3,h-41,3,3);
    }
  }
  tex.refresh();
}

function drawIcon(ctx, type, c1, c2){
  ctx.imageSmoothingEnabled = false;
  switch(type){
    case 'book':
      ctx.fillStyle=c1; ctx.fillRect(2,4,16,14);
      ctx.fillStyle=c2; ctx.fillRect(2,4,16,3);
      ctx.fillStyle='#fff'; ctx.fillRect(4,9,12,1); ctx.fillRect(4,12,12,1);
      break;
    case 'cap':
      ctx.fillStyle=c1; ctx.beginPath(); ctx.moveTo(10,3); ctx.lineTo(19,8); ctx.lineTo(10,13); ctx.lineTo(1,8); ctx.closePath(); ctx.fill();
      ctx.fillStyle=c2; ctx.fillRect(8,12,4,6);
      ctx.fillStyle=c1; ctx.fillRect(16,8,2,7);
      break;
    case 'scroll':
      ctx.fillStyle=c1; ctx.fillRect(3,5,14,11);
      ctx.fillStyle=c2; ctx.fillRect(1,4,3,13); ctx.fillRect(16,4,3,13);
      break;
    case 'globe':
      ctx.fillStyle=c1; ctx.beginPath(); ctx.arc(10,10,8,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle=c2; ctx.lineWidth=1.4;
      ctx.beginPath(); ctx.ellipse(10,10,8,3.5,0,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(10,2); ctx.lineTo(10,18); ctx.stroke();
      break;
    case 'flag':
      ctx.fillStyle='#4c7a5c'; ctx.fillRect(4,2,2,16);
      ctx.fillStyle=c1; ctx.fillRect(6,3,11,5);
      ctx.fillStyle=c2; ctx.fillRect(6,8,11,5);
      break;
    case 'trophy':
      ctx.fillStyle=c1; ctx.fillRect(7,3,6,8);
      ctx.beginPath(); ctx.arc(6,5,3,Math.PI*0.5,Math.PI*1.5); ctx.fill();
      ctx.beginPath(); ctx.arc(14,5,3,Math.PI*1.5,Math.PI*0.5); ctx.fill();
      ctx.fillStyle=c2; ctx.fillRect(8,11,4,3); ctx.fillRect(5,15,10,2);
      break;
    case 'compass':
      ctx.strokeStyle=c1; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(10,10,8,0,Math.PI*2); ctx.stroke();
      ctx.fillStyle=c2;
      ctx.beginPath(); ctx.moveTo(10,4); ctx.lineTo(12,10); ctx.lineTo(10,16); ctx.lineTo(8,10); ctx.closePath(); ctx.fill();
      break;
    case 'medal':
      ctx.fillStyle=c2; ctx.fillRect(7,1,2,7); ctx.fillRect(11,1,2,7);
      ctx.fillStyle=c1; ctx.beginPath(); ctx.arc(10,13,7,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(10,13,3,0,Math.PI*2); ctx.fill();
      break;
    case 'seal':
      ctx.fillStyle=c1; ctx.beginPath(); ctx.arc(10,10,8,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle=c2; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(10,10,5,0,Math.PI*2); ctx.stroke();
      break;
    case 'coin':
      ctx.fillStyle=c1; ctx.beginPath(); ctx.arc(10,10,8,0,Math.PI*2); ctx.fill();
      ctx.fillStyle=c2; ctx.font='bold 11px monospace'; ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText('€', 10, 11);
      break;
    case 'handshake':
      ctx.fillStyle=c1; ctx.fillRect(2,9,7,4);
      ctx.fillStyle=c2; ctx.fillRect(11,9,7,4);
      ctx.fillStyle='#fff'; ctx.fillRect(8,8,4,6);
      break;
    case 'calendar':
      ctx.fillStyle=c1; ctx.fillRect(2,4,16,13);
      ctx.fillStyle=c2; ctx.fillRect(2,4,16,4);
      ctx.fillStyle='#fff';
      for(let i=0;i<3;i++)for(let j=0;j<3;j++) ctx.fillRect(4+i*5,10+j*2.5,3,1.5);
      break;
    case 'computer':
      ctx.fillStyle=c1; ctx.fillRect(2,3,16,10);
      ctx.fillStyle=c2; ctx.fillRect(3,4,14,8);
      ctx.fillStyle=c1; ctx.fillRect(7,13,6,3); ctx.fillRect(4,16,12,1.5);
      break;
    case 'megaphone':
      ctx.fillStyle=c1;
      ctx.beginPath(); ctx.moveTo(2,9); ctx.lineTo(9,4); ctx.lineTo(9,16); ctx.lineTo(2,11); ctx.closePath(); ctx.fill();
      ctx.fillStyle=c2; ctx.fillRect(9,7,8,5);
      ctx.strokeStyle=c1; ctx.lineWidth=1.4;
      ctx.beginPath(); ctx.arc(18,9.5,4,-0.8,0.8); ctx.stroke();
      break;
    case 'mic':
      ctx.fillStyle=c1; ctx.beginPath(); ctx.roundRect ? ctx.roundRect(7,2,6,10,3) : ctx.rect(7,2,6,10); ctx.fill();
      ctx.strokeStyle=c2; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(10,10,5,0.2,Math.PI-0.2); ctx.stroke();
      ctx.fillStyle=c2; ctx.fillRect(9,15,2,4); ctx.fillRect(6,18,8,1.5);
      break;
    case 'star':
      ctx.fillStyle=c1;
      ctx.beginPath();
      for(let i=0;i<5;i++){
        const a1 = -Math.PI/2 + i*(2*Math.PI/5);
        const a2 = a1 + Math.PI/5;
        ctx.lineTo(10+8*Math.cos(a1), 10+8*Math.sin(a1));
        ctx.lineTo(10+3.2*Math.cos(a2), 10+3.2*Math.sin(a2));
      }
      ctx.closePath(); ctx.fill();
      break;
    case 'briefcase':
      ctx.fillStyle=c2; ctx.fillRect(7,2,6,3);
      ctx.fillStyle=c1; ctx.fillRect(2,6,16,11);
      ctx.fillStyle=c2; ctx.fillRect(9,10,2,3);
      break;
    case 'frame':
      ctx.strokeStyle=c1; ctx.lineWidth=3; ctx.strokeRect(2,2,16,16);
      ctx.fillStyle=c2; ctx.fillRect(5,5,10,10);
      break;
    default:
      ctx.fillStyle=c1; ctx.fillRect(3,3,14,14);
  }
}
function makeIconTexture(scene, key, type, c1, c2){
  if(scene.textures.exists(key)) return;
  const tex = scene.textures.createCanvas(key, 20, 20);
  drawIcon(tex.getContext(), type, c1, c2);
  tex.refresh();
}

