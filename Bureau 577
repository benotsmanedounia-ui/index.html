function buildWalls(scene, title){
  const g = scene.add.graphics().setDepth(1);
  g.fillStyle(0x4a2140, 1);
  g.fillRect(0,0,W,60);
  g.fillStyle(0x7fae8e, 1);
  g.fillRect(0,60,W,4);
  g.fillStyle(0x4a2140, 0.85);
  g.fillRect(0,0,18,H);
  g.fillRect(W-18,0,18,H);
  g.fillStyle(0x4a2140, 0.85);
