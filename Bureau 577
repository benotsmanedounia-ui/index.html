/* ---- Envoi réel par e-mail, sans serveur, via un relais tiers (FormSubmit) ----
   FormSubmit reçoit la requête depuis le navigateur du visiteur et transfère le
   message directement dans la boîte mail de CONFIG.email. La toute première fois
   qu'un message part vers une adresse, FormSubmit envoie un mail de confirmation
   à cette adresse (une seule fois) qu'il faut valider — ensuite, tout arrive
   automatiquement, sans rien à refaire. */
function sendMailRelay(fields){
  return fetch(`https://formsubmit.co/ajax/${encodeURIComponent(CONFIG.email)}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify(Object.assign({ _captcha:'false', _template:'table' }, fields))
  }).then(r=> r.ok).catch(()=> false);
}

